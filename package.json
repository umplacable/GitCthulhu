{
  "name": "gitcthulhu",
  "version": "1.0.0",
  "description": "Client Git graphique simple avec interface React pour gérer vos dépôts",
    "homepage": "https://grond.iut-fbleau.fr/hochlaf/GitCthulhu",
  "main": "main.js",
  "scripts": {
    "start": "webpack --mode production && electron .",
    "sass": "sass --load-path=node_modules/@picocss/pico/scss/ --watch public/scss:dist/css",
    "build": "webpack --mode production",
    "package": "npm run build && electron-builder --win",
    "package-linux": "npm run build && electron-builder --linux",
    "package-mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.gitcthulhu.app",
    "productName": "GitCthulhu",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "public/icons/favicon-dark.ico",
      "public/icons/favicon-light.ico",
      "public/icons/favicon.ico",
      "public/icons/favicon.png",
      "node_modules/simple-git/**/*",
      "node_modules/@kwsites/**/*",
      "node_modules/debug/**/*",
      "!node_modules/@parcel/watcher-*"
    ],
    "extraResources": [
      {
        "from": "node_modules/simple-git",
        "to": "node_modules/simple-git"
      },
      {
        "from": "node_modules/@kwsites",
        "to": "node_modules/@kwsites"
      },
      {
        "from": "node_modules/debug",
        "to": "node_modules/debug"
      }
    ],
    "asar": true,
    "mac": {
      "icon": "public/icons/favicon.png"
    },
    "win": {
      "icon": "public/icons/favicon.ico",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "public/icons/favicon.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "maintainer": "Hochlaf"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@kwsites/file-exists": "^1.1.1",
    "@kwsites/promise-deferred": "^1.1.1",
    "@parcel/watcher": "^2.4.1",
    "debug": "^4.4.3",
    "fs": "^0.0.1-security",
    "ini": "^5.0.0",
    "marked": "^16.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass": "^1.92.0",
    "simple-git": "^3.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@picocss/pico": "^2.1.1",
    "babel-loader": "^10.0.0",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "html-webpack-plugin": "^5.6.4",
    "wait-on": "^9.0.1",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}